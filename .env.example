# -------------------------------------------------------
# 202BBQ environment variables
# Copy to .env.local for local builds. Never commit .env.local.
# In production these come from GitHub Actions secrets (see CONTENT.md).
# A missing value never fakes success: the form shows a "call us" error instead.
# -------------------------------------------------------

# Formspree endpoints (https://formspree.io → each form's submit URL)
VITE_FORMSPREE_ORDERS=https://formspree.io/f/REPLACE_ME      # order requests (#order)
VITE_FORMSPREE_CATERING=https://formspree.io/f/REPLACE_ME    # event requests (#catering); falls back to CONTACT
VITE_FORMSPREE_CONTACT=https://formspree.io/f/REPLACE_ME     # fallback inbox for event requests
VITE_FORMSPREE_REVIEWS=https://formspree.io/f/REPLACE_ME     # reviews

# Stripe Payment Link for the $20 order deposit (setup steps in CONTENT.md).
# While unset, the confirmation screen tells the customer Matt will text a payment link.
VITE_STRIPE_DEPOSIT_LINK=https://buy.stripe.com/REPLACE_ME
